<Project><PropertyGroup><BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).runtime/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath><BaseOutputPath>$(MSBuildThisFileDirectory).runtime/bin/$(MSBuildProjectName)/</BaseOutputPath><LangVersion>7.3</LangVersion><Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings><EnableDefaultCompileItems>false</EnableDefaultCompileItems><Deterministic>true</Deterministic><DeterministicSourcePaths>true</DeterministicSourcePaths><PathMap>$(MSBuildThisFileDirectory)=/_/src/</PathMap><TreatWarningsAsErrors>true</TreatWarningsAsErrors></PropertyGroup></Project>
